String gpsString;
void loop()
{
   while (Serial1.available()) {
    uint8_t b = Serial1.read();
    Serial.print((char)b);
   }

}


void sendUBXcommand(uint8_t * cmduint8_ts , int len)
{
  for(int i =0 ; i<len;i++)
  Serial1.write(cmduint8_ts[i]);
  
  Serial1.flush();
 
}

